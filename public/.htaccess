<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|frontend-version\.txt)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header always set Clear-Site-Data "\"cache\""
  </FilesMatch>

  <FilesMatch "\.(?:js|css|woff2?|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule Litespeed>
  CheckSpamIP 0
</IfModule>

<IfModule mod_rewrite.c>
  Options +FollowSymLinks -Indexes
  DirectoryIndex index.html index.php

  RewriteEngine On
  RewriteBase /
  
  RewriteRule ^index\.html$ - [L]

  # Proxy API requests to proxy.php
  RewriteRule ^api/(.*)$ proxy.php?path=$1 [L,QSA]

  # Allow direct access to PHP files
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.php$
  RewriteRule . /index.html [L]
</IfModule>
LSRecaptchaEnable off  
